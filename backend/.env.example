# ── Security ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/aistock.db

# ── CORS (comma separated origins) ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Analysis engine ─────────────────────────────────────────────────────
# Root of the original Streamlit project (parent of backend/ by default).
PROJECT_ROOT=..
DEBUG=false

# LLM API keys are still read from the ROOT project's .env
# (MINIMAX_API_KEY / DEEPSEEK_API_KEY / ...). BACKEND_URL may be set there
# or passed per-request via llm_base_url.
