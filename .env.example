# ── LLM 配置（整个项目统一读取）───────────────────────────────────────
# CLI / Web / Pipeline / examples 全部从这里读取，只需配一个 provider + 一个模型。
# 修改后重启程序即可生效。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=

# Provider 专属思考模式参数（可选，仅在使用对应 provider 时生效）
# LLM_THINKING_LEVEL=high        # Google Gemini: "high" / "minimal"
# LLM_REASONING_EFFORT=medium    # OpenAI: "high" / "medium" / "low"
# LLM_EFFORT=high                # Anthropic: "high" / "medium" / "low"

# Claude Agent SDK provider（仅个人自用，可选依赖 [agentsdk]）。
# 让 deep_thinking_llm 节点走你个人 Claude Pro/Max 订阅额度而非按 token 计费的 API。
# 用 `claude setup-token`（已登录 Pro/Max 账号）生成后填这里。
# ⚠️ 与 ANTHROPIC_API_KEY 不可共存：API key 优先级更高会悄悄走 API 计费，
#    启用该 provider 时若检测到 ANTHROPIC_API_KEY 会直接报错中止（护栏）。
CLAUDE_CODE_OAUTH_TOKEN=

# ── Backend 服务（FastAPI，v0.5.14 起与上面合并到同一个 .env）──────────
# backend/ 默认从这里读全部服务变量（单一事实来源）；backend/.env 若存在
# 则优先级更高，仅作本地覆盖。以下全部可选，不写则用代码默认值。
# JWT 签名密钥，生产必改：python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# DATABASE_URL=sqlite:///<backend>/data/aistock.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEBUG=false
